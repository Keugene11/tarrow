{
  "name": "tarrow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cap:prepare": "node -e \"const fs=require('fs');fs.mkdirSync('out',{recursive:true});for(const f of ['index.html','error.html'])fs.copyFileSync('capacitor-web/'+f,'out/'+f)\"",
    "cap:sync": "pnpm cap:prepare && npx cap sync",
    "android:apk": "pnpm cap:prepare && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
